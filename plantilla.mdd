			.VerticalAlign = VerticalAlignments.vaBottom
			.Align = Alignments.alCenter
			.Cell.BgColor = "#004e69"
			.Color="#FFFFFF"
			.cell.Width = "10%"
			.cell.BorderColor="#004E69"
			.Cell.borderStyle = BorderStyles.bsSolid
			.Cell.borderWidth = 1
	  	End With
	
			'Alternate Cells
	  	IOM.DefaultStyles.Grids[GridStyleTypes.gsAltRow].Cell.BgColor = "#D5DEE8"
	  	IOM.DefaultStyles.Grids[GridStyleTypes.gsAltRowHeader].Cell.BgColor = "#D5DEE8"
	
			'All Cells
	  	With IOM.DefaultStyles.Grids[GridStyleTypes.gsCell]
			.cell.BorderColor="#004E69"
			.Cell.borderStyle = BorderStyles.bsSolid
			.Cell.borderWidth = 1
	  	End With
	
			'Head Row
	  	With IOM.DefaultStyles.Grids[GridStyleTypes.gsRowHeader]
			.cell.BorderColor="#004E69"
	   		.Cell.borderStyle = BorderStyles.bsSolid
	   		.Cell.borderWidth = 1
	  	End With
	  	
	End Function
	
	'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
	'		SET MARKERS 													'
	'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
	'
	Function SetSample(IOM)
		
		Dim objField, tSfield, tErrFields
		
		tSfield = getSampleFields(IOM)	
		
	'	If FindItem(tSfield,"SYNID") &lt;&gt; NULL then
	'    	IOM.Questions["SampSYNID"] = IOM.SampleRecord["SYNID"]
	'    else
	'    	tErrFields = tErrFields + "SYNID,"
	'    end if
	'    
	'    If FindItem(tSfield,"GRP") &lt;&gt; NULL then
	'    	IOM.Questions["SampGRP"]   = IOM.SampleRecord["GRP"]
	'    else 
	'    	tErrFields = tErrFields + "GRP,"
	'    End if
	    
	    dim qName
	    'SET SAMPLE VARIABLES FOR EACH VARIABLE CREATED IN THE BLOCK
	    For Each objField In IOM.Questions["SampleFields"]
	   		qName = UCASE(Mid(objField.QuestionName,4))
	    
	    	If FindItem(tSfield, qName) &lt;&gt; NULL then
		    	objField.Response = Trim(IOM.SampleRecord[qName].Value)
		    else
		    	tErrFields = tErrFields + qName + ","
		    end if
	    Next
	    
	    	tErrFields = Left(tErrFields,Len(tErrFields)-1)
	    	
	    	if len(tErrFields)&gt;0 then
	    		Err.Raise(1,,"ERROR: The following sample fields (" + tErrFields + ") are used in the interview script but are not available in the Sample Table. Please check...")
	 		end if
			
	End Function
	
	Function SetSampleOffline(IOM)
	
	    Dim objFields
	    
	    IOM.Questions["SampSYNID"].Response = "1000"
	    IOM.Questions["SampGRP"].Response = "011"
	    
	    Set objFields = IOM.Questions["SampleFields"]
	    
	    'SET SAMPLE VARIABLES MANUALLY FOR EACH VARIABLE CREATED IN THE BLOCK
	    objFields["SampPhoneNumber"].Response = "1111111"
	    objFields["SampQueue"].Response = "FRESH"
	    objFields["SampTimeZone"].Response = "230"
		
	End Function
	
	Function InitMarker(IOM)
		
		'COMPLETE MARKER
	  	IOM.Questions["COMP"].Response = {Quit}
	
		'QUIT MARKER
	  	IOM.Questions["QUITSTAT"].Response = {QuitScreener}
	
		'VERSION MARKER. COMMENT CHANGES AT TOP OF ROUTING WINDOW.
	  	IOM.Questions["VERSION"].Response=1
		
		'SET DATE OF INTERVIEW
	  	IOM.Questions["CurrentDay"].Response = Day(Now())
	  	IOM.Questions["CurrentMonth"].Response = Month(Now())
	  	IOM.Questions["CurrentYear"].Response = Year(Now())
	  
	  	
		'SET LANGUAGE MARKER.
	'	If (Trim(IOM.SampleRecord["LanguageID"].Value) &lt;&gt; "") Then
	'  	    IOM.Questions["LanguageID"].Response = CCategorical("{" + UCase(Trim(IOM.SampleRecord["LanguageID"].Value)) + "}")
	'  	    IOM.Language = IOM.Questions["LanguageID"].Categories[IOM.Questions["LanguageID"]].Name
	'  	End If
	    
	    IOM.Questions["LanguageID"].Response = {ESN}
	    IOM.Language = "ESN"
	
	  	'RESPONDENT INSTRUCTIONS
	  	IOM.Questions["SPT"].Response = {Single}
	  	IOM.Questions["MPT"].Response = {Multi}
	  	IOM.Questions["OET"].Response = {OpenEnd}
	  	IOM.Questions["CLRON"].Response = {FONT}
	  	IOM.Questions["CLROFF"].Response = {FONT}
	
	End Function
	
	'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
	'		QUOTAS      													'
	'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
	Function SetQuota(IOM, QuotaQuestion, QuotaCell)
		
		'SEE PROGRAMMING LIBRARY/QUOTA.MDD FOR AN EXAMPLE OF HOW TO USE QUOTA FUNCTION.
	    'SET QUOTA MARKER
	    If (IOM.Info.IsReview) Then
	       QuotaQuestion.Response = QuotaQuestion.Info.OffPathResponse
	    Else
	         QuotaQuestion.Response = QuotaQuestion.Response + QuotaQuestion.Categories[QuotaCell].Value
	    End If
	    
	End Function
	
	Function CheckQuota(IOM, QuotaQuestion)
	
		'SEE PROGRAMMING LIBRARY/QUOTA.MDD FOR AN EXAMPLE OF HOW TO USE QUOTA FUNCTION.	
		
		'CheckQuota RESULT:
		'-----------------
		' CheckQuota = 0 =&gt; SUCCESSFULLY PENDED OR IN DEBUG MODE
		' CheckQuota = 1 =&gt; OVERQUOTA
		' CheckQuota = -1 =&gt; QUOTAQUESTION IS NULL
		
	      'DEFINE QUOTA RESULT VARIABLE
	      Dim quota_pend_result
	      Dim lngResult
	      
	      'INITIALLY SET TO 0(ZERO)
	      lngResult = 0
	      
	      'IF QUOTA IS NULL TERMINATE
	      If(QuotaQuestion = Null) then
	        'IOM.Questions["TNUM"].Response = {TNUM60}
	        lngResult = -1            
	      End if
	          
	      'PEND QUOTA IN CASE THE INTERVIEW QUOTA ENGINE IS INITIALIZED / IN USE AND
	      'IF IT IS NOT IN REVIEW MODE:
	      If Not(IsNullObject(IOM.QuotaEngine)) Then
	      
	         If Not(IOM.Info.IsReview) Then
	            quota_pend_result = IOM.QuotaEngine.QuotaGroups[QuotaQuestion.QuestionName].Pend()  
	
	          	  'CHECK RESULTS OF PEND. IF FULL GOTO OVERQUOTA TO END INTERVIEW.
			      If Not(IsSet(quota_pend_result, QuotaResultConstants.qrWasPended)) Then
			            lngResult = 1
			      End If
		      
	         End If
	         
	      End If     
	            
	    CheckQuota = lngResult
	    
	End Function
	
	
	'======[ I N T E R V I E W  E V E N T S  S E C T I O N ]=================
	'
	'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
	'		EVENTS      													'
	'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
	Sub OnInterviewStart(IOM)
	    
	    'TIME-MARKERS ARE UPDATED UNLES THE INTERVIEW IS IN 'REVIEW' MODE
	    If Not(IOM.Info.IsReview) Then
	    
			'When the interview starts, take time stamps and prepare the case data markers by evaluating if the session
			'is new or restart (and type of restart)
			
			IOM.Questions["TimeSessionStarted"].Response = Now()
			IOM.Questions["TimeLastActivity"].Response = IOM.Questions["TimeSessionStarted"].Response
		
			if IOM.Questions["TimeSurveyStarted"].Info.OffPathResponse = null then
				if IOM.Info.Timeouts &gt; 0 then
					'Debug.Log("Int_Start(" + ctext(IOM.info.Serial) + ") - Existing Survey (Resumed Timeout (browser NOT closed))")
					IOM.Questions["TimeElapsedSeconds"].Response = IOM.Questions["TimeElapsedSeconds"].Response
					IOM.Questions["TimeOutCount"].Response = IOM.Questions["TimeOutCount"].Response - IOM.Info.Timeouts
					IOM.Questions["RestartCount"].Response = IOM.Questions["RestartCount"].Response + 1
				elseif IOM.Questions["TimeSurveyStarted"].Response &lt;&gt; null then
					'Debug.Log("Int_Start(" + ctext(IOM.info.Serial) + ") - Existing Survey (Engine failover)")
					IOM.Questions["TimeElapsedSeconds"].Response = IOM.Questions["TimeElapsedSeconds"].Response
					IOM.Questions["TimeOutCount"].Response = IOM.Questions["TimeOutCount"].Response - IOM.Info.Timeouts
					IOM.Questions["RestartCount"].Response = IOM.Questions["RestartCount"].Response + 1
				else
					'Debug.Log("Int_Start(" + ctext(IOM.info.Serial) + ") - New Survey")
					IOM.Questions["TimeSurveyStarted"].Response = IOM.Questions["TimeSessionStarted"].Response
					IOM.Questions["TimeElapsedSeconds"].Response = 0
					IOM.Questions["TimeOutCount"].Response = 0
					IOM.Questions["RestartCount"].Response = 0
				end if
			else
				'Debug.Log("Int_Start(" + ctext(IOM.info.Serial) + ") - Existing Survey (Resumed Timeout (browser closed), or stopped script, or engine failover (from another server?))")
				IOM.Questions["TimeSurveyStarted"].Response = IOM.Questions["TimeSurveyStarted"].Info.OffPathResponse
				IOM.Questions["TimeElapsedSeconds"].Response = IOM.Questions["TimeElapsedSeconds"].Info.OffPathResponse
				IOM.Questions["TimeOutCount"].Response = IOM.Questions["TimeOutCount"].Info.OffPathResponse
				IOM.Questions["RestartCount"].Response = IOM.Questions["RestartCount"].Info.OffPathResponse + 1
			end if
		
	    End If
		
	End Sub
	
	Sub OnAfterQuestionAsk(Question, IOM)
	    
	    'TIME-MARKERS ARE UPDATED UNLES THE INTERVIEW IS IN 'REVIEW' MODE
	    If Not(IOM.Info.IsReview) Then    
		   'Add any other code you may need into this same sub routine (eg: progress bar stuff). Always keep UpdateCalcTime in here!
		   'After each question is asked, calculate the elapsed time since the last activity stamp
		   UpdateCalcTime("Page", IOM)	   
		End If
		
	End Sub
	
	Sub OnInterviewEnd(IOM)
	    
	    'TIME-MARKERS ARE UPDATED UNLES THE INTERVIEW IS IN 'REVIEW' MODE
	    If Not(IOM.Info.IsReview) Then
	       'At the end of the interview, calculate the elapsed time since the last activity stamp
		   UpdateCalcTime("Interview", IOM)	
		End If
		
	End Sub
	
	''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
	' AUXILIARY EVENTS FUNCTIONS                                                 '
	' [PLACE HERE ALL THE ADDITIONAL FUNCTIONS CALLED WITIHIN THE EVENTS ABOVE!] '
	''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
	Function UpdateCalcTime(sEvent, IOM)
	
		Dim nActiveLength 'as Long (numeric)
		
		'Sometimes case data markers are blank (seemingly during replay for restarted sessions). Since the markers aren't
		'intialised, we should skip any calculations until the session is in an acceptable state. So, we assume that in
		'order for calculations to be done, TimeLastActivity or TimeElapsedSeconds cannot be empty (null or blank).
		If Not IsEmpty(IOM.Questions["TimeLastActivity"].Response) And Not IsEmpty(IOM.Questions["TimeElapsedSeconds"].Response) Then
	
			'if the calling event is the OnInterviewEnd, then stamp the end session marker and update timeout counter	
			If LCase(Trim(sEvent)) = "interview" Then
				IOM.Questions["TimeSessionEnded"].Response = Now()
				IOM.Questions["TimeOutCount"].Response = IOM.Questions["TimeOutCount"].Response + IOM.Info.Timeouts
			End If
			
			'Do the calculation between now and the time of last activity
			nActiveLength = DateDiff(IOM.Questions["TimeLastActivity"].Response, Now(), "s")
			
			'If the activty length is not more than a second, then don't update the Elapsed time marker.
			If nActiveLength &gt; 0 Then
				IOM.Questions["TimeElapsedSeconds"].Response = IOM.Questions["TimeElapsedSeconds"].Response + nActiveLength
			End If
			
			'Update the pages answered counter from IOM object and create the new stamp for Last activity
			IOM.Questions["PagesAnsweredCount"].Response = CText(IOM.Info.PagesAnswered)
			IOM.Questions["TimeLastActivity"].Response = Now()
			
		End If
		
	End Function
	
	Function getLocalTime(IOM)
	
	  Dim lngTimeZone
	  Dim isDayLightSaving
	  Dim ignoreDayLightSaving
	
	  'Get Time Zone code from the sample database.
	  'If such a code is not provided, then set to UTC (-1).
	  'NOTE: Change the name of the Time Zone field to the appropriate one if it is needed!
	   If(Trim(IOM.SampleRecord["TimeZone"].Value) &lt;&gt; "") Then
	      lngTimeZone = CLong(Trim(IOM.SampleRecord["TimeZone"].Value))
	   Else
	       lngTimeZone = -1
	   End If
	  
	  'Check if the DayLight Saving is in effect(whether is SUMMER TIME) for the respective TimeZone:
	   isDayLightSaving = GetTimeZoneDaylightSaving(lngTimeZone, Now(lngTimeZone))
	 
	  'If it is SUMMER TIME, do not ignore the SUMMER TIME adjustments
	   If (isDayLightSaving) Then
	       ignoreDayLightSaving = False
	  'Otherwise (If it is WINTER TIME) ignore the SUMMER TIME adjustments
	   Else
	        ignoreDayLightSaving = True
	   End If
	   
	   getLocalTime = Now(lngTimeZone, ignoreDayLightSaving)
	  
	End Function
	
	'PROPOSED FUNCTIONS FOR REVISION
	'DESCRIPTION: Returns a list of all the available / existing sample fields in the sample database on the server.
	Function getSampleFields(IOM)
	
	Dim objField, tSfield
		
	    tSfield = ""
		For Each objField In IOM.SampleRecord
			tSfield = tSfield + objField.Name + ","
		Next
	
		getSampleFields = Split(UCASE(Left(tSfield,Len(tSfield)-1)),",")
	End Function
	"</script><script name="main" hash="zQFFX15c1ux/f5tbszrtPRzRaG982AYgOJLxRCG7PKQ=" default="-1">"	'!#################################################################
	IMPLEMENTATION OF THE CATI STANDARD (MANDATORY SETTINGS):
	This section describes specific parts of the shell that need to be set up in order 
	for the script to function correctly and with accordance to the Global CATI standard:
	
	+ Sample Fields:
		- All sample data that needs to be read into the interview script has to be added to the 'SampleFields' block.
		
		- The questions defined there need to follow a specific naming convention in order for the script to read them
		automatically: Each field's name must begin with the prefix 'Samp, followed by the name of the field that is read from
		the sample table(e.g.: If the field in the sample file is named Age, then the variable defined in the SampleFields block
		must be named 'SampAge').					
	
		- If Variables defined in the SampleFields block follow the naming convention above but the respective sample field does not exist, 
		the script will show a: 'ERROR: The following sample fields (XXX) are used in the interview script but are not available
		in the Sample Table. Please check...' error. This applies only to running the survey in live mode (when IOM.info.IsDebug = false or
		IOM.Info.IsTest = false) but the screen cannot be skipped and the field cannot start before the issue is addressed. This error
		is also logged.
		
	+ Quotas:
		- The CheckQuota() and SetQuota() routines have to be used when punching/pending quotas in the Interview script.
		- A single quota MUST be present in the survey in order for the project to appear in the CATI Reporting site.
	
	+ Handling of terminate, complete and over quota situations:
		- The only allowed signals for exiting the survey are: 
			- The range from 1 to 7;
			- The range from 170-179 for user defined refusals (QUEUE = REFUSED);
			- The range from 180-189 for user defined Standard outs (QUEUE = UNUSIBLE);
			- The range from 190-199 for user defined Recalls (Queue=RECALL with NoAnswer Delay applied)
			- The range from 200-249 for Teminates (Must match TNUM values)
			- The range from 250-299. DK/NA Teminates (Must match TNUM values)
			- Any other signal used will trigger unintended changes to the respondent's sample status.
	
	 #################################################################!'
	
	
	'***** Declaration Section *****
	 Const QFULL = 1
	 Const QNULL = -1
	
	 Dim bTestData 'Boolean marker to indicate Test Data case
	 Dim lngTermSig 'Terminate signal
	 Dim lngSampGrNum 'Temporary long variable to hold the number stored in the 'SampGRP' sample variable
	 Dim txtSampGrName 'Temporary text variable to form and hold the name of the sample group number
	
	'******* Retain Random Seed *******
	 If(RANSEED.Info.OffPathResponse = Null) Then
	    RANSEED = CText(GetRandomSeed())
	 Else
	     RANSEED.Response = RANSEED.Info.OffPathResponse
	 End If
	    
	 SetRandomSeed(CLong(RANSEED.Response))
	
	'******* Set Test Data Marker *******
	 'bTestData = CBoolean(IIf(LCase(IOM.Info.Renderer) = "xmlplayer", True, False)) '- running test data using Load Tool
	 bTestData = IIf(IOM.Info.IsAutoAnswer, True, False) '- running test data on mrStudio
		
	'***** Configuration Section *****	
	 If Not(IOM.Info.IsDebug or IOM.Info.IsTest or IOM.Info.IsAutoAnswer) Then 
		on error resume next
		SetSample(IOM)
	'		if err.Number&lt;&gt;0 then
	'			ErrorMSG.Label.Inserts["ins"] = err.Description
	'			ErrorMSG.Show()
	'			IOM.Terminate(Signals.sigError,true,TerminateStatus.tsScriptStopped)
	'		end if
	'	on error goto 0
		
	 Else
	     SetSampleOffline(IOM)
	     SampleFields.Ask()
	 End If
		
	 ConfigDisplay(IOM)
	 InitMarker(IOM)
	
	 
	 '''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
	 '        	GROUPTAB												     '
	 '    ASK GROUPTAB IN DEBUG OR TEST, SET FROM SAMPLE WHEN ACTIVE 		 '
	 '''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
	 If(IOM.Info.IsTest or IOM.Info.IsDebug or IOM.Info.IsAutoAnswer)  Then
	    GROUPTAB.Label.Inserts["SerialNo"]=IOM.Info.Serial
	    GROUPTAB.Ask()
	 Else 
	      'CHECK IF THE 'SampGr' FIELD IS NOT EMPTY
	      If (Trim(SampGRP.Response) &lt;&gt; "") Then
	         
	         'IF IT IS NOT EMPTY, GET THE STORED VALUE AND FORM THE NAME OF THE CATEGORY TO BE ASSIGNED TO
	         'THE 'GROUPTAB' VARIABLE
	         lngSampGrNum = CLong(Trim(SampGRP.Response))
	         txtSampGrName = Trim("GRPNUM" + IIf(Len(CText(lngSampGrNum)) &gt; 1, "0" + CText(lngSampGrNum), "00" + CText(lngSampGrNum)))
	         
	         'ADDITIONAL CHECK IF SUCH A CATEGORY DOES EXIST AT ALL FOR THE 'GROUPTAB' VARIABLE
	         If (IOM.MDM.Document.Fields["GROUPTAB"].Elements.Exist[txtSampGrName]) Then
	            GROUPTAB.Response = CCategorical("{" + txtSampGrName + "}")
	         End If
	      
	      End If
	
	 End If
	  	
	''''================================[ B E G I N  E X C E P T I O N - H A N D L I N G ]=======================================
	''
	' EXCEPTION-HANDLING STARTUP POINT
	 On Error GoTo ErrorHandler
	
	' EXCEPTION-HANDLING LOGIC BLOCK
	Section ErrorHandler
		
	 'Allows interviewer to resume if script error encountered and stores error details in the data
	 Dim __err_msg, __error
		
		If (Err.Number &lt;&gt; 0) then
			
	  		__err_msg = "Script error at line " + CText(Err.LineNumber) + ", " + Err.Description
			IOM.Log(__err_msg, LogLevels.LOGLEVEL_ERROR)
	
			ErrorHandler.ErrorDetails = Left("Line " + CText(Err.LineNumber) + ": " + Err.Location + " " + Err.Description, ErrorHandler.ErrorDetails.Validation.MaxValue)
			
			ErrorHandler.ErrorContinue.Ask()
			If (ErrorHandler.ErrorContinue.ContainsAny({yes})) Then 
	'			Resume Next
			Else
				IOM.Terminate(signals.sigError, True, TerminateStatus.tsScriptStopped)
			End If
			
		End If
	'	
	End Section
	
