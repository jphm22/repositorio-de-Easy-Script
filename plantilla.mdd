60-99eb-a7317ce9fd49" name="_5"><properties><property name="value" value="5" type="3" context="Question"/></properties><labels context="LABEL"><text context="QUESTION" xml:lang="es-PE">...o meu dia foi cheio de coisas que me interessavam</text></labels></category></categories><class name="@class" global-name-space="-1"><types name="@types" global-name-space="-1"><deleted/></types><fields name="@fields" global-name-space="-1"><deleted/><variable id="_3089b006-a0c7-4a74-b9d6-b72a9faf2123" name="Rp" ref="3089b006-a0c7-4a74-b9d6-b72a9faf2123"/></fields><pages name="@pages" global-name-space="-1"><deleted/></pages></class><notes><property name="5@note1" value="observacion: No genero el grid completo" type="8" context="Question"/></notes></loop><variable id="_d0d24168-0317-4244-9070-b631f9525b5a" name="P1" ref="d0d24168-0317-4244-9070-b631f9525b5a"/><variable id="_a438452b-d714-491e-89a5-8e3cd95b03bd" name="P2" ref="a438452b-d714-491e-89a5-8e3cd95b03bd"/><variable id="_9c11c6f0-9456-48fe-94da-2a4a9ad63c4e" name="P3" ref="9c11c6f0-9456-48fe-94da-2a4a9ad63c4e"/><variable id="_3c67ac53-74fe-42c4-afd0-5240da6d6d5c" name="P4" ref="3c67ac53-74fe-42c4-afd0-5240da6d6d5c"/><variable id="_c091a3f5-5bdc-449a-acbd-82514fb2f971" name="P5" ref="c091a3f5-5bdc-449a-acbd-82514fb2f971"/><loop id="_fa6d4dc4-ceb3-43d6-bf5b-5fdb70d68002" name="P6" type="1" isgrid="1" iteratortype="2"><labels context="LABEL"><text context="QUESTION" xml:lang="es-PE">P6. O quanto você concorda ou discorda que este PERFUME:</text></labels><categories global-name-space="-1"><properties><property name="DisplayOrder" value="Randomized" type="8" context="Question"/></properties><deleted/><category id="_a3ecc11e-d64d-462e-8408-ea912aa821c9" name="_1"><properties><property name="value" value="1" type="3" context="Question"/></properties><labels context="LABEL"><text context="QUESTION" xml:lang="es-PE">É de luxo/alto padrão</text></labels></category><category id="_40f23e76-8a6b-4654-bfc8-097a7410a756" name="_2"><proper