b1e428b-4eef-40d9-b40f-3795591712c0" name="SHELL_CLOSE" ref="4b1e428b-4eef-40d9-b40f-3795591712c0"/><variable id="_c5ce9b3a-6976-41f4-8007-a488a8c44d97" name="SHELL_DDG_STATUS" ref="c5ce9b3a-6976-41f4-8007-a488a8c44d97"/><variable id="_92ea4d88-77cb-410e-8e71-6de34dfa9ba6" name="SHELL_NAME" ref="92ea4d88-77cb-410e-8e71-6de34dfa9ba6"/><class id="_424474cd-ae89-4d70-830c-aed7b749ff56" name="SHELL_BLOCK_TEL" global-name-space="0"><labels context="LABEL"><text context="QUESTION" xml:lang="es-PE">Telephone number(s)</text><text context="QUESTION" xml:lang="en-US">Telephone number(s)</text></labels><types name="@types" global-name-space="-1"><deleted/></types><fields name="@fields" global-name-space="-1"><deleted/><variable id="_b83bfce2-5b98-426d-917a-f84c73113fb9" name="SHELL_MOBTEL" ref="b83bfce2-5b98-426d-917a-f84c73113fb9"/><variable id="_41fbee8e-0760-4267-8dd8-9bc64c84b742" name="SHELL_HOMETEL" ref="41fbee8e-0760-4267-8dd8-9bc64c84b742"/><variable id="_ceb5aa85-0ab3-41f6-b0dd-fb6f949c8641" name="SHELL_BC_EMAIL" ref="ceb5aa85-0ab3-41f6-b0dd-fb6f949c8641"/></fields><pages name="@pages" global-name-space="-1"><deleted/></pages></class><variable id="_624e6a41-7437-484a-a8ac-bf5f6ac2341e" name="SHELL_TEL" ref="624e6a41-7437-484a-a8ac-bf5f6ac2341e"/><variable id="_73255d29-1579-4ca2-a1f9-d5e4dc9a3bb3" name="SHELL_TEXTTEL" ref="73255d29-1579-4ca2-a1f9-d5e4dc9a3bb3"/><variable id="_c7f13827-e74e-446c-83b6-7fa93a108b07" name="SHELL_EMAIL" ref="c7f13827-e74e-446c-83b6-7fa93a108b07"/><class id="_8895b016-e46c-447e-990e-ccdf9b7e07c5" name="SHELL_BLOCK_ADDRESS" global-name-space="0"><labels context="LABEL"><text context="QUESTION" xml:lang="es-PE">Respondent address</text><text context="QUESTION" xml:lang="en-US">Respondent address</text></labels><types name="@types" global-name-space="-1"><deleted/></types><fields name="@fields" global-name-space="-1"><deleted/><variable id="_3aeab973-0085-495b-a368-a6e41c30471a" name="SHELL_HOUSENO" ref="3aeab973-0085-495b-a368-a6e41c30471a"/><variable id="_94a06f4b-9bf9-40de-8468-7d07022eda09" name="SHELL_STREET" ref="94a06f4b-9bf9-40de-8468-7d07022eda09"/><variable id="_3d0a12ea-fec1-42d8-808f-89bf2f553936" name="SHELL_DISTRICT" ref="3d0a12ea-fec1-42d8-808f-89bf2f553936"/><variable id="_0ea2d486-b19b-4918-a447-3cc1de4624ce" name="SHELL_TOWN" ref="0ea2d486-b19b-4918-a447-3cc1de4624ce"/><variable id="_45144afd-2fad-4565-8da6-4929da50b90b" name="SHELL_ZIP" ref="45144afd-2fad-4565-8da6-4929da50b90b"/></fields><pages name="@pages" global-name-space="-1"><deleted/></pages></class><variable id="_216402b9-0a89-472b-ab9e-b13a35668d55" name="SHELL_ADDRESS" ref="216402b9-0a89-472b-ab9e-b13a35668d55"/><variable id="_02b35ccf-74fa-4fb5-92c4-171d4f548289" name="SHELL_COMP_MODE" ref="02b35ccf-74fa-4fb5-92c4-171d4f548289"/><variable id="_7d53dba4-44b5-4a0d-82fe-1aca6c73ce13" name="SHELL_IP_ADDRESS" ref="7d53dba4-44b5-4a0d-82fe-1aca6c73ce13"/><variable id="_a6c843b0-696d-4bd5-a7fe-16d43bdc38d3" name="_BHP" ref="a6c843b0-696d-4bd5-a7fe-16d43bdc38d3"/><variable id="_06991ae5-fec5-4642-aa1c-f00e11d1fc49" name="_PAQ" ref="06991ae5-fec5-4642-aa1c-f00e11d1fc49"/><variable id="_3f8f21c4-b8c9-421b-8d0e-fb257a5d1517" name="SHELL_SUP" ref="3f8f21c4-b8c9-421b-8d0e-fb257a5d1517"/></fields><types name="@types" global-name-space="-1"><deleted/></types><pages name="@pages" global-name-space="-1"><deleted/></pages><routings><properties><property name="CATI" type="9" context="Question"><properties><property name="SuppressErrorHandler" value="-1" type="8" context="Question"/><property name="SuppressHeader" value="-1" type="8" context="Question"/></properties></property><property name="PAPER" type="9" context="Question"><properties><property name="SuppressErrorHandler" value="0" type="8" context="Question"/><property name="SuppressHeader" value="0" type="8" context="Question"/></properties></property></properties><scripts><deleted/><scripttype type="mrScriptBasic" context="CATI" interviewmodes="0" usekeycodes="-1"><deleted/><script name="source" hash="zQFFX15c1ux/f5tbszrtPRzRaG982AYgOJLxRCG7PKQ=">"	'!#################################################################
	IMPLEMENTATION OF THE CATI STANDARD (MANDATORY SETTINGS):
	This section describes specific parts of the shell that need to be set up in order 
	for the script to function correctly and with accordance to the Global CATI standard:
	
	+ Sample Fields:
		- All sample data that needs to be read into the interview script has to be added to the 'SampleFields' block.
		
		- The questions defined there need to follow a specific naming convention in order for the script to read them
		automatically: Each field's name must begin with the prefix 'Samp, followed by the name of the field that is read from
		the sample table(e.g.: If the field in the sample file is named Age, then the variable defined in the SampleFields block
		must be named 'SampAge').					
	
		- If Variables defined in the SampleFields block follow the naming convention above but the respective sample field does not exist, 
		the script will show a: 'ERROR: The following sample fields (XXX) are used in the interview script but are not available
		in the Sample Table. Please check...' error. This applies only to running the survey in live mode (when IOM.info.IsDebug = false or
		IOM.Info.IsTest = false) but the screen cannot be skipped and the field cannot start before the issue is addressed. This error
		is also logged.
		
	+ Quotas:
		- The CheckQuota() and SetQuota() routines have to be used when punching/pending quotas in the Interview script.
		- A single quota MUST be present in the survey in order for the project to appear in the CATI Reporting site.
	
	+ Handling of terminate, complete and over quota situations:
		- The only allowed signals for exiting the survey are: 
			- The range from 1 to 7;
			- The range from 170-179 for user defined refusals (QUEUE = REFUSED);
			- The range from 180-189 for user defined Standard outs (QUEUE = UNUSIBLE);
			- The range from 190-199 for user defined Recalls (Queue=RECALL with NoAnswer Delay applied)
			- The range from 200-249 for Teminates (Must match TNUM values)
			- The range from 250-299. DK/NA Teminates (Must match TNUM values)
			- Any other signal used will trigger unintended changes to the respondent's sample status.
	
	 #################################################################!'
	
	
	'***** Declaration Section *****
	 Const QFULL = 1
	 Const QNULL = -1
	
	 Dim bTestData 'Boolean marker to indicate Test Data case
	 Dim lngTermSig 'Terminate signal
	 Dim lngSampGrNum 'Temporary long variable to hold the number stored in the 'SampGRP' sample variable
	 Dim txtSampGrName 'Temporary text variable to form and hold the name of the sample group number
	
	'******* Retain Random Seed *******
	 If(RANSEED.Info.OffPathResponse = Null) Then
	    RANSEED = CText(GetRandomSeed())
	 Else
	     RANSEED.Response = RANSEED.Info.OffPathResponse
	 End If
	    
	 SetRandomSeed(CLong(RANSEED.Response))
	
	'******* Set Test Data Marker *******
	 'bTestData = CBoolean(IIf(LCase(IOM.Info.Renderer) = "xmlplayer", True, False)) '- running test data using Load Tool
	 bTestData = IIf(IOM.Info.IsAutoAnswer, True, False) '- running test data on mrStudio
		
	'***** Configuration Section *****	
	 If Not(IOM.Info.IsDebug or IOM.Info.IsTest or IOM.Info.IsAutoAnswer) Then 
		on error resume next
		SetSample(IOM)
	'		if err.Number&lt;&gt;0 then
	'			ErrorMSG.Label.Inserts["ins"] = err.Description
	'			ErrorMSG.Show()
	'			IOM.Terminate(Signals.sigError,true,TerminateStatus.tsScriptStopped)
	'		end if
	'	on error goto 0
		
	 Else
	     SetSampleOffline(IOM)
	     SampleFields.Ask()
	 End If
		
	 ConfigDisplay(IOM)
	 InitMarker(IOM)
	
	 
	 '''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
	 '        	GROUPTAB												     '
	 '    ASK GROUPTAB IN DEBUG OR TEST, SET FROM SAMPLE WHEN ACTIVE 		 '
	 '''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
	 If(IOM.Info.IsTest or IOM.Info.IsDebug or IOM.Info.IsAutoAnswer)  Then
	    GROUPTAB.Label.Inserts["SerialNo"]=IOM.Info.Serial
	    GROUPTAB.Ask()
	 Else 
	      'CHECK IF THE 'SampGr' FIELD IS NOT EMPTY
	      If (Trim(SampGRP.Response) &lt;&gt; "") Then
	         
	         'IF IT IS NOT EMPTY, GET THE STORED VALUE AND FORM THE NAME OF THE CATEGORY TO BE ASSIGNED TO
	         'THE 'GROUPTAB' VARIABLE
	         lngSampGrNum = CLong(Trim(SampGRP.Response))
	         txtSampGrName = Trim("GRPNUM" + IIf(Len(CText(lngSampGrNum)) &gt; 1, "0" + CText(lngSampGrNum), "00" + CText(lngSampGrNum)))
	         
	         'ADDITIONAL CHECK IF SUCH A CATEGORY DOES EXIST AT ALL FOR THE 'GROUPTAB' VARIABLE
	         If (IOM.MDM.Document.Fields["GROUPTAB"].Elements.Exist[txtSampGrName]) Then
	            GROUPTAB.Response = CCategorical("{" + txtSampGrName + "}")
	         End If
	      
	      End If
	
	 End If
	  	
	''''================================[ B E G I N  E X C E P T I O N - H A N D L I N G ]=======================================
	''
	' EXCEPTION-HANDLING STARTUP POINT
	 On Error GoTo ErrorHandler
	
	' EXCEPTION-HANDLING LOGIC BLOCK
	Section ErrorHandler
		
	 'Allows interviewer to resume if script error encountered and stores error details in the data
	 Dim __err_msg, __error
		
		If (Err.Number &lt;&gt; 0) then
			
	  		__err_msg = "Script error at line " + CText(Err.LineNumber) + ", " + Err.Description
			IOM.Log(__err_msg, LogLevels.LOGLEVEL_ERROR)
	
			ErrorHandler.ErrorDetails = Left("Line " + CText(Err.LineNumber) + ": " + Err.Location + " " + Err.Description, ErrorHandler.ErrorDetails.Validation.MaxValue)
			
			ErrorHandler.ErrorContinue.Ask()
			If (ErrorHandler.ErrorContinue.ContainsAny({yes})) Then 
	'			Resume Next
			Else
				IOM.Terminate(signals.sigError, True, TerminateStatus.tsScriptStopped)
			End If
			
		End If
	'	
	End Section
	
	''''================================[ E N D  E X C E P T I O N - H A N D L I N G ]===========================================
	  	
	'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
	'        	SCREENER QUESTIONS      									'
	'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
	If (IOM.Info.IsDebug Or IOM.Info.IsTest) Then
	    'PCUEST.Ask()
	    E.Ask()
	    QUOTA1={GEREN_46}
	Else
	if not isempty(IOM.SampleRecord.Item["COD_TIPO_PYME"].Value) then
		E.Response = Ccategorical("{_" + IOM.SampleRecord.Item["COD_TIPO_PYME"].Value + "}")	
	end if	
	
	QUOTA1.Response = Ccategorical("{" + TRIM(IOM.SampleRecord.Item["QUOTA1"].Value) + "}")
	
	PHONE_CODE = IOM.SampleRecord.Item["PHONE_CODE"].Value
	PHONE_NUMBER = IOM.SampleRecord.Item["PHONE_NUMBER"].Value
	NAME = IOM.SampleRecord.Item["NAME"].Value
	IDENC = IOM.SampleRecord.Item["IDENC"].Value
	CODESTUDIO=IOM.SampleRecord.Item["CODESTUDIO"].Value
	TPHONE = IOM.SampleRecord.Item["TPHONE"].Value
	ID = IOM.SampleRecord.Item["ID"].Value
 	TIMEZONE = IOM.SampleRecord.Item["TIMEZONE"].Value
	CODCLAVECIC=IOM.SampleRecord.Item["CODCLAVECIC"].Value
	NOMBRE_COMPLETO=IOM.SampleRecord.Item["NOMBRE_COMPLETO"].Value
	TELF_1=IOM.SampleRecord.Item["TELF_1"].Value
	EMAIL_1=IOM.SampleRecord.Item["EMAIL_1"].Value
	RUC=IOM.SampleRecord.Item["RUC"].Value
	DEPARTAMENTO=IOM.SampleRecord.Item["DEPARTAMENTO"].Value
	TIPO_PERSONA=IOM.SampleRecord.Item["TIPO_PERSONA"].Value
	RESIDENCIA=IOM.SampleRecord.Item["RESIDENCIA"].Value
	TIPO_CLIENTE=IOM.SampleRecord.Item["TIPO_CLIENTE"].Value
	FLG_DEUDA=IOM.SampleRecord.Item["FLG_DEUDA"].Value
	U_TIPO_CARTERA = IOM.SampleRecord.Item["U_TIPO_CARTERA"].Value
	U_HUB = IOM.SampleRecord.Item["U_HUB"].Value
	U_GER_OFICINA = IOM.SampleRecord.Item["U_GER_OFICINA"].Value
	MEDICION=IOM.SampleRecord.Item["MEDICION"].Value
	FECHA_INYECCION=IOM.SampleRecord.Item["FECHA_INYECCION"].Value

	End If
	
	'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
	'        	QUOTAS LOGIC        										'
	'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
	'1. QUOTA1 IS SET BASED ON QUESTION 'QX'
	    'SET TO '_YES' OR '_NO' DEPENDING ON WHETHER THE QUOTA IS SET FROM THE
	    'SAMPLE OR NOT:
	       'IS_SAMPLE_BASED_QUOTA.Response = {_YES}
		   IS_SAMPLE_BASED_QUOTA.Response = {_NO}
	'	    Select Case QX.Response
	'	           Case {R1} 
	'	                SetQuota(IOM,QUOTA1, {QUOTA1_CELL1})
	'	           Case {R2}
	'	                SetQuota(IOM,QUOTA1, {QUOTA1_CELL2})
	'	           Case {R3} 
	'	                SetQuota(IOM,QUOTA1, {QUOTA1_CELL3})
	'	           Case {R4}
	'	                SetQuota(IOM,QUOTA1, {QUOTA1_CELL4})
	'	           Case {R5}
	'	                SetQuota(IOM,QUOTA1, {QUOTA1_CELL5})
	'	    End Select
	'    
	' 'PENDING QUOTA1 AND CHECK THE RESULT RETURNED BY THE PENDING FUNCTION  
	  Select Case CheckQuota(IOM, QUOTA1)  
	         Case QNULL
	              GoTo Term         
	         Case QFULL
	              GoTo OVERQUOTA
	  End Select
	  
	'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
	'        	MAIN QUESTIONNAIRE QUESTIONS								'
	'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
	PA.ask()
	if (PA.Response.ContainsAny({_2})) then
	INFO_RECALENDIZAR.show()
		TNUM.Response.Value = {TNUM201}
		GoTo TERM
	end if
	if (PA.Response.ContainsAny({_98})) then
		TNUM.Response.Value = {TNUM202}
		GoTo TERM
	end if
	
	PB.ask()
	PC.Ask()
	
	if (PC.Response.ContainsAny({_2})) then
		TNUM.Response.Value = {TNUM203}
		GoTo TERM
	end if	
	PC1.Ask()
	D.Ask()
	'E.Ask()
	If (IOM.Info.IsDebug Or IOM.Info.IsTest) Then
		E.Show()
	End if
	P1.Ask()
	P2.Categories.Filter=P1
	P2.Ask()
	
'	dim lista
'	lista={_1,_2,_3,_6,_96}
'	if E={_1} then lista=lista + {_4}
'	if E={_2} then lista=lista + {_5}
'	P2_1.Categories.Filter=lista
'	P2_1.Ask()
'	if (P2_1.Response.ContainsAny({_96})) then
'		TNUM.Response.Value = {TNUM204}
'		GoTo TERM
'	end if
	
	P3.Ask()
'	if P3.containsAny({_9,_10}) then P3_1.Ask()
'	if P3.containsAny({_7,_8}) then P3_2.Ask()
'	if P3.containsAny({_0,_1,_2,_3,_4,_5,_6}) then P3_3.Ask()

	if P3.containsAny({_9,_10}) then P3_1_NEW.Ask()
	if P3.containsAny({_7,_8}) then P3_2_NEW.Ask()
	if P3.containsAny({_0,_1,_2,_3,_4,_5,_6}) then P3_3_NEW.Ask()

	
	'P56.Ask()
	
	'If P56 = {_2} Then
		'GoTo saltoP2_1
	'End If
	
	'P57.Ask()
	'if P57.containsAny({_9,_10}) then P57_1.Ask()
	'if P57.containsAny({_0,_1,_2,_3,_4,_5,_6}) then P57_2.Ask()
	
	'saltoP2_1:
	'dim lista
	'lista={_1,_2,_3,_6,_96}
	'if E={_1} then lista=lista + {_4}
	'if E={_2} then lista=lista + {_5}
	'P2_1.Categories.Filter=lista
	'P2_1.Ask()
	'if (P2_1.Response.ContainsAny({_96})) then
		'TNUM.Response.Value = {TNUM204}
		'GoTo TERM
	'end if
	
	'P6.Ask()
	'P7.Ask()
	'saltoP8:
	'P8.Ask()
	'dim sErrMsgTotal
	'sErrMsgTotal="No se permite NP en el atributo D"
	'if P8[{_4}].Rp={_99} then
			'sErrMsgTotal= "&lt;font color='red'&gt;&lt;b&gt;" + sErrMsgTotal + "&lt;/b&gt;&lt;/font&gt;"
			'P8.Banners.Clear()
		    'P8.Banners.AddNew("errSum", sErrMsgTotal)
		'goto saltoP8
	'end if
	 'sErrMsgTotal="No se permite NP en el atributo E"
	'if P8[{_5}].Rp={_99} then
			'sErrMsgTotal= "&lt;font color='red'&gt;&lt;b&gt;" + sErrMsgTotal + "&lt;/b&gt;&lt;/font&gt;"
