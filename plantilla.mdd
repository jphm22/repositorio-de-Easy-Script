type="2"><labels context="LABEL"><text context="QUESTION" xml:lang="es-PE">ESTA ENCUESTA SERÁ ELIMINADA POR NO CUMPLIR CON FILTRO DE LA ENCUESTA</text><text context="QUESTION" xml:lang="en-US">&lt;strong&gt;ESTA ENCUESTA SERÁ ELIMINADA POR NO CUMPLIR CON FILTRO DE LA ENCUESTA&lt;/strong&gt;</text></labels></variable><variable id="9f1c665b-2719-455a-8322-9e8fb062f5f3" name="SHELL_CLOSE" type="0"><properties><property name="_Osm_QuestionLayoutID" value="10" type="3" context="Question"/><property name="_Osm_IsRequired" value="0" type="11" context="Question"/></properties><labels context="LABEL"><text context="QUESTION" xml:lang="es-PE">Thank you very much for participating in our survey. We sometimes re-contact respondents via text message, email or telephone, to verify that the market research was indeed carried out. For this purpose we require some contact details from you in order to be able to check this should your interview be selected for quality control.</text><text context="QUESTION" xml:lang="en-US">Thank you very much for participating in our survey. We sometimes re-contact respondents via text message, email or telephone, to verify that the market research was indeed carried out. For this purpose we require some contact details from you in order to be able to check this should your interview be selected for quality control.</text></labels></variable><variable id="c5ce9b3a-6976-41f4-8007-a488a8c44d97" name="SHELL_DDG_STATUS" type="2" min="0" mintype="3" max="4000" maxtype="3"><labels context="LABEL"><text context="QUESTION" xml:lang="es-PE">SHELL_DDG_STATUS</text><text context="QUESTION" xml:lang="en-US">SHELL_DDG_STATUS</text></labels></variable><variable id="92ea4d88-77cb-410e-8e71-6de34dfa9ba6" name="SHELL_NAME" type="2" min="0" mintype="3" max="200" maxtype="3"><labels context="LABEL"><text context="QUESTION" xml:lang="es-PE">Respondent name:</text><text context="QUESTION" xml:lang="en-US">Respondent name:</text></labels></variable><variable id="b83bfce2