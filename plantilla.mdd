xt="QUESTION" xml:lang="es-PE">Refuse</text><text context="QUESTION" xml:lang="en-US">Refuse</text></labels><properties><property name="value" value="8" type="3" context="Question"/></properties></category></categories></variable><variable id="550df8a1-71a2-4673-8cb3-8207c86dcb53" name="SHELL_INFO_PROJECTSCRIPT_START" type="0"><properties><property name="_Osm_IsRequired" value="0" type="11" context="Question"/><property name="_Osm_AttachmentNamingPattern" value="%ORIGINALFILENAME%" type="8" context="Question"/></properties><labels context="LABEL"><text context="QUESTION" xml:lang="es-PE">Scripter, add the project specific questions after this Info item and before the SHELL_CLOSE question.</text><text context="QUESTION" xml:lang="en-US">Scripter, add the project specific questions after this Info item and before the SHELL_CLOSE question.</text></labels></variable><variable id="9b04c8fe-1a74-408a-a6f8-f139a93cbb42" name="P0" type="3" min="1" mintype="3" max="1" maxtype="3"><labels context="LABEL"><text context="QUESTION" xml:lang="es-PE">Buenos días/ Buenas tardes/ Buenas noches, Señor/ Señora (____________). Mi nombre es [SU NOMBRE]. Estoy realizando encuestas para Ipsos, empresa de investigación dedicada a conocer, a través de encuestas, la opinión de personas como usted acerca de diferentes temas. Esta encuesta tiene una duración aproximada de 15 Minutos. Sus respuestas no afectarán su relación con Ipsos o los clientes de Ipsos, y puede desistir de la encuesta en cualquier momento. Le pedimos que toda la información que reciba sea mantenida bajo confidencialidad. Si tiene preguntas sobre el estudio en el que va a participar, puede comunicarse con la persona responsable del estudio: Juan Bravo a la siguiente dirección de correo electrónico: juan.Bravo@ipsos.com Usted no será identificado en ninguna publicación de resultados. Sus respuestas serán confidenciales y solo los resultados agregados serán analizados. Todos sus datos serán protegidos bajo la ley colombiana de datos personales. Por favor refiérase a la Política de Privacidad de este estudio en el siguiente link: https://ipsoslatam.com/pd/R95z Al realizar la encuesta, usted está declarando que ha leído y que acepta la Política. P0. ¿Está interesado/a en participar en la encuesta?</text><text context="QUESTION" xml:lang="en-US">Buenos días/ Buenas tardes/ Buenas noches, Señor/ Señora (____________). Mi nombre es [SU NOMBRE]. Estoy realizando encuestas para Ipsos, empresa de investigación dedicada a conocer, a través de encuestas, la opinión de personas como usted acerca de diferentes temas.&lt;br/&gt;&lt;br/&gt; Esta encuesta tiene una duración aproximada de 15 Minutos. Sus respuestas no afectarán su relación con Ipsos o los clientes de Ipsos, y puede desistir de la encuesta en cualquier momento. Le pedimos que toda la información que reciba sea mantenida bajo confidencialidad.&lt;br/&gt;&lt;br/&gt; Si tiene preguntas sobre el estudio en el que va a participar, puede comunicarse con la persona responsable del estudio: Juan Bravo a la siguiente dirección de correo electrónico: juan.Bravo@ipsos.com&lt;br/&gt;&lt;br/&gt; Usted no será identificado en ninguna publicación de resultados. Sus respuestas serán confidenciales y solo los resultados agregados serán analizados. Todos sus datos serán protegidos bajo la ley colombiana de datos personales.&lt;br/&gt;&lt;br/&gt; Por favor refiérase a la Política de Privacidad de este estudio en el siguiente link: &lt;a href="https://ipsoslatam.com/pd/R95z" target="_blank"&gt;https://ipsoslatam.com/pd/R95z&lt;/a&gt;&lt;br/&gt;&lt;br/&gt; Al realizar la encuesta, usted está declarando que ha leído y que acepta la Política.&lt;br/&gt;&lt;br/&gt; P0. ¿Está interesado/a en participar en la encuesta?</text></labels><categories global-name-space="-1"><deleted/><category id="_f71a4112-cfaa-4ec5-b407-b5f6e50613be" name="_1"><properties><property name="value" value="1" type="3" context="Question"/></properties><labels context="LABEL"><text context